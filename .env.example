# storybook 环境变量样例
# 复制为 .env 并按需修改（当前 config.py 不自动加载 .env，需自行 export 或用 direnv 等工具）

# Ollama 服务地址
OLLAMA_HOST=http://localhost:11434

# LLM 模型（做梦加工：摘要/关键词/分裂判断）
STORYBOOK_LLM_MODEL=qwythos-hermes:latest

# Qwen3 思考模式：0=关闭(默认，提取类任务约 9x 加速)，1=开启(准确率不足时)
STORYBOOK_LLM_THINK=0

# Embedding 模型（必须 1024 维，与 config.EMBED_DIM 一致）
STORYBOOK_EMBED_MODEL=qwen3-embedding:0.6b
