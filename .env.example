# storybook 环境变量样例
# 复制为 .env 并按需修改。config.py 启动时会自动加载项目根 .env
# （无则跳过、不报错）。此文件只包含运行目录和算法参数，不配置模型。

# 可选：把 Profile registry、数据、缓存与日志收拢到显式隔离目录。
# 默认不设置，使用 macOS/Linux/Windows 的用户级规范目录。
# STORYBOOK_HOME=/path/to/private/storybook-home
#
# 可选：仅本次进程选择某个 Profile（UUID 或 display_name），不改 registry 当前项。
# STORYBOOK_PROFILE=default

# 模型配置不从环境变量读取：复制 model-config.example.json 为 model-config.json，
# 编辑其中的四元组后导入当前 Profile。此 .env 文件无需填写模型密钥。
# book init --config model-config.json
# book config --path  # 导入后实际生效的配置文件

# 重复 reprocess 的 Profile 私有输入哈希缓存，以及批量推理准备并发数。
STORYBOOK_INFERENCE_CACHE_ENABLED=1
STORYBOOK_PROCESS_WORKERS=4

# 仅约束 abstract/recall 展示；structured detail 与 sources 不会硬截断。
STORYBOOK_ABSTRACT_MAX_CHARS=600
STORYBOOK_RECALL_SUMMARY_MAX_CHARS=600

# 查询快路径：每次 embedding 请求续期 Ollama 模型驻留。
STORYBOOK_EMBED_KEEP_ALIVE=10m

# 查询硬超时：warm/cold embedding 到点立即切换到关键词 fallback；
# fallback 自身也有独立 500ms 预算。
STORYBOOK_QUERY_WARM_TIMEOUT_SECONDS=2
STORYBOOK_QUERY_COLD_TIMEOUT_SECONDS=5
STORYBOOK_QUERY_FALLBACK_TIMEOUT_SECONDS=0.5

# 自适应检索：fast 是无生成式 LLM 的默认值；auto 只在低置信/复合/跨语言/
# 环境歧义时进入第二阶段；deep 由调用方显式选择且总预算默认 5s。
STORYBOOK_QUERY_DEFAULT_MODE=fast
STORYBOOK_QUERY_TRANSFORM_ENABLED=1
STORYBOOK_QUERY_AUTO_CONFIDENCE_THRESHOLD=0.62
STORYBOOK_QUERY_AUTO_TRANSFORM_TIMEOUT_SECONDS=1.2
STORYBOOK_QUERY_AUTO_SECOND_STAGE_TIMEOUT_SECONDS=2.0
STORYBOOK_QUERY_DEEP_TRANSFORM_TIMEOUT_SECONDS=3.5
STORYBOOK_QUERY_DEEP_SECOND_STAGE_TIMEOUT_SECONDS=4.0
STORYBOOK_QUERY_DEEP_TOTAL_TIMEOUT_SECONDS=5.0

# 本地轻量 reranker：只处理有界 top-N；超时/连续失败时回退融合排名并熔断。
STORYBOOK_RERANK_ENABLED=1
STORYBOOK_RERANK_TOP_N=20
STORYBOOK_RERANK_TIMEOUT_SECONDS=0.08
STORYBOOK_RERANK_FAILURE_THRESHOLD=2
STORYBOOK_RERANK_CIRCUIT_COOLDOWN_SECONDS=30

# 可选：进程内版本化缓存（修改 Story/索引后由 index_version 自动失效）。
# STORYBOOK_QUERY_VECTOR_CACHE_SIZE=256
# STORYBOOK_QUERY_RESULT_CACHE_SIZE=128
# STORYBOOK_QUERY_VECTOR_CACHE_TTL_SECONDS=900
# STORYBOOK_QUERY_RESULT_CACHE_TTL_SECONDS=300
